@page
@model LogoutModel
@{
    ViewData["Title"] = "Cerrar sesión";
}

<div class="auth-wrap">
    <div class="auth-card text-center">
        <span class="auth-logo">🎓</span>
        <h1 class="h3 mt-2">Cerrar sesión</h1>
        @{
            if (User.Identity?.IsAuthenticated ?? false)
            {
                <p class="text-muted-claude">¿Seguro que quieres salir del portal?</p>
                <form class="form-inline" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Page("/", new { area = "" })" method="post">
                    <button type="submit" class="btn btn-clay">Sí, cerrar sesión</button>
                </form>
            }
            else
            {
                <p class="text-muted-claude">Has cerrado sesión correctamente.</p>
                <a class="btn btn-outline-clay" asp-area="" asp-controller="Home" asp-action="Index">Volver al inicio</a>
            }
        }
    </div>
</div>
