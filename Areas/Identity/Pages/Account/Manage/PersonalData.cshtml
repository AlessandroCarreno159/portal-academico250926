@page
@model PersonalDataModel
@{
    ViewData["Title"] = "Datos personales";
    ViewData["ActivePage"] = ManageNavPages.PersonalData;
}

<div class="auth-card" style="max-width: 720px; margin: 2rem auto;">
    <span class="eyebrow">Cuenta</span>
    <h3>Datos personales</h3>

    <div class="row">
        <div class="col-md-8">
            <p>Tu cuenta contiene los datos personales que nos has proporcionado. Aquí puedes descargarlos o eliminarlos.</p>
            <p>
                <strong>Eliminar estos datos borrará tu cuenta de forma permanente y no se podrá recuperar.</strong>
            </p>
            <form id="download-data" asp-page="DownloadPersonalData" method="post">
                <button class="btn btn-outline-clay" type="submit">Descargar mis datos</button>
            </form>
            <p class="mt-3">
                <a id="delete" asp-page="DeletePersonalData" class="btn btn-danger">Eliminar mi cuenta</a>
            </p>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
