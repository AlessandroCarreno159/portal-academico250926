@page
@using Microsoft.AspNetCore.Http.Features
@model TwoFactorAuthenticationModel
@{
    ViewData["Title"] = "Verificación en dos pasos (2FA)";
    ViewData["ActivePage"] = ManageNavPages.TwoFactorAuthentication;
}

<div class="auth-card" style="max-width: 720px; margin: 2rem auto;">
    <span class="eyebrow">Cuenta</span>
    <partial name="_StatusMessage" for="StatusMessage" />
    <h3>Verificación en dos pasos</h3>
    @{
        var consentFeature = HttpContext.Features.Get<ITrackingConsentFeature>();
        @if (consentFeature?.CanTrack ?? true)
        {
            @if (Model.Is2faEnabled)
            {
                if (Model.RecoveryCodesLeft == 0)
                {
                    <div class="alert alert-danger">
                        <strong>No te quedan códigos de recuperación.</strong>
                        <p>Debes <a asp-page="./GenerateRecoveryCodes">generar un nuevo conjunto de códigos</a> antes de iniciar sesión con un código de recuperación.</p>
                    </div>
                }
                else if (Model.RecoveryCodesLeft == 1)
                {
                    <div class="alert alert-danger">
                        <strong>Te queda 1 código de recuperación.</strong>
                        <p>Puedes <a asp-page="./GenerateRecoveryCodes">generar un nuevo conjunto de códigos</a>.</p>
                    </div>
                }
                else if (Model.RecoveryCodesLeft <= 3)
                {
                    <div class="alert alert-clay">
                        <strong>Te quedan @Model.RecoveryCodesLeft códigos de recuperación.</strong>
                        <p>Deberías <a asp-page="./GenerateRecoveryCodes">generar un nuevo conjunto de códigos</a>.</p>
                    </div>
                }

                if (Model.IsMachineRemembered)
                {
                    <form method="post" style="display: inline-block">
                        <button type="submit" class="btn btn-outline-clay">Olvidar este navegador</button>
                    </form>
                }
                <a asp-page="./Disable2fa" class="btn btn-outline-clay">Desactivar 2FA</a>
                <a asp-page="./GenerateRecoveryCodes" class="btn btn-outline-clay">Restablecer códigos</a>
            }

            <h4 class="mt-4">App de autenticación</h4>
            @if (!Model.HasAuthenticator)
            {
                <a id="enable-authenticator" asp-page="./EnableAuthenticator" class="btn btn-clay">Agregar app de autenticación</a>
            }
            else
            {
                <a id="enable-authenticator" asp-page="./EnableAuthenticator" class="btn btn-clay">Configurar app de autenticación</a>
                <a id="reset-authenticator" asp-page="./ResetAuthenticator" class="btn btn-outline-clay">Restablecer app</a>
            }
        }
        else
        {
            <div class="alert alert-danger">
                <strong>No se aceptó la política de privacidad y cookies.</strong>
                <p>Debes aceptar la política antes de activar la verificación en dos pasos.</p>
            </div>
        }
    }
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
