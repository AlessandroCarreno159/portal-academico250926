@model portal_academico.Models.CursoCatalogoItem
@{
    ViewData["Title"] = Model.Curso.Nombre;
}

<div class="p-4 p-md-5 mb-4 hero-claude">
    <span class="eyebrow">@Model.Curso.Codigo</span>
    <h1 class="display-6">@Model.Curso.Nombre</h1>
    <p class="text-muted-claude mb-0">Detalle del curso e inscripción.</p>
</div>

@if (TempData["Ok"] is string ok)
{
    <div class="alert alert-success">@ok</div>
}
@if (TempData["Error"] is string err)
{
    <div class="alert alert-clay">@err</div>
}

<div class="card card-claude mb-4">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">Código</dt>
            <dd class="col-sm-9"><strong>@Model.Curso.Codigo</strong></dd>
            <dt class="col-sm-3">Créditos</dt>
            <dd class="col-sm-9">@Model.Curso.Creditos</dd>
            <dt class="col-sm-3">Horario</dt>
            <dd class="col-sm-9">@Model.Curso.HorarioInicio.ToString("HH:mm") - @Model.Curso.HorarioFin.ToString("HH:mm")</dd>
            <dt class="col-sm-3">Cupo máximo</dt>
            <dd class="col-sm-9">@Model.Curso.CupoMaximo</dd>
            <dt class="col-sm-3">Cupo disponible</dt>
            <dd class="col-sm-9">
                @if (Model.CuposDisponibles > 0)
                {<span class="badge badge-est">@Model.CuposDisponibles libres de @Model.Curso.CupoMaximo</span>}
                else
                {<span class="badge badge-inv">Agotado</span>}
            </dd>
        </dl>
    </div>
</div>

<div class="d-flex flex-wrap gap-2">
    @if (User.Identity?.IsAuthenticated == true)
    {
        <form asp-controller="Matriculas" asp-action="Inscribirse" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="cursoId" value="@Model.Curso.Id" />
            <button type="submit" class="btn btn-clay">Inscribirse</button>
        </form>
    }
    else
    {
        <a class="btn btn-clay" asp-area="Identity" asp-page="/Account/Login" asp-route-returnUrl="@Url.Action("Details", "Catalogo", new { id = Model.Curso.Id })">Inicia sesión para inscribirte</a>
    }
    <a asp-action="Index" class="btn btn-outline-clay">← Volver al catálogo</a>
</div>
