@model portal_academico.Models.HomeIndexViewModel
@{
    ViewData["Title"] = "Inicio";
}

<div class="p-4 p-md-5 mb-4 hero-claude">
    <span class="eyebrow">Semestre 2026 · Examen parcial</span>
    <h1 class="display-5">Portal Académico</h1>
    <p class="lead mb-1">Gestión de cursos y matrículas de la universidad.</p>
    <p class="text-muted-claude">Explora la oferta de cursos activos e inscríbete en un clic. Cuenta de coordinador: <code>coordinador@uni.edu</code>.</p>
    <div class="d-flex flex-wrap gap-2 mt-3">
        <a class="btn btn-clay" asp-controller="Catalogo" asp-action="Index">Ver catálogo</a>
        @if (User.Identity?.IsAuthenticated == true)
        {
            <a class="btn btn-outline-clay" asp-controller="Matriculas" asp-action="MisMatriculas">Mis matrículas</a>
        }
        else
        {
            <a class="btn btn-outline-clay" asp-area="Identity" asp-page="/Account/Login">Iniciar sesión para inscribirte</a>
        }
        @if (Model.EsCoordinador)
        {
            <a class="btn btn-warning" asp-controller="Coordinador" asp-action="Index">Panel Coordinador</a>
        }
    </div>
</div>

@if (User.Identity?.IsAuthenticated == false)
{
    <div class="alert alert-clay">Inicia sesión para inscribirte en un curso.</div>
}

<div class="row mb-4 g-3">
    <div class="col-md-4">
        <div class="card card-claude text-center h-100">
            <div class="card-body">
                <h5 class="card-title text-muted-claude">Cursos activos</h5>
                <p class="stat-num">@Model.TotalCursos</p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card card-claude text-center h-100">
            <div class="card-body">
                <h5 class="card-title text-muted-claude">Cupo total ofertado</h5>
                <p class="stat-num">@Model.TotalCupos</p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card card-claude text-center h-100">
            <div class="card-body">
                <h5 class="card-title text-muted-claude">Mi rol</h5>
                <p class="fs-5">
                    @if (Model.EsCoordinador)
                    {<span class="badge badge-coord">Coordinador</span>}
                    else if (User.Identity?.IsAuthenticated == true)
                    {<span class="badge badge-est">Estudiante</span>}
                    else
                    {<span class="badge badge-inv">Invitado</span>}
                </p>
            </div>
        </div>
    </div>
</div>

<h2>Oferta destacada</h2>
<p class="text-muted-claude">Una selección de cursos activos de este semestre.</p>
@if (!Model.CursosRecientes.Any())
{
    <div class="alert alert-clay">No hay cursos activos por el momento.</div>
}
else
{
    <div class="table-responsive">
    <table class="table table-claude align-middle mb-0">
        <thead>
            <tr>
                <th>Código</th>
                <th>Nombre</th>
                <th>Créditos</th>
                <th>Horario</th>
                <th>Cupo</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var c in Model.CursosRecientes)
            {
                <tr>
                    <td><strong>@c.Codigo</strong></td>
                    <td>@c.Nombre</td>
                    <td>@c.Creditos</td>
                    <td>@c.HorarioInicio.ToString("HH:mm") - @c.HorarioFin.ToString("HH:mm")</td>
                    <td>@c.CupoMaximo</td>
                    <td><a asp-controller="Catalogo" asp-action="Details" asp-route-id="@c.Id">Ver →</a></td>
                </tr>
            }
        </tbody>
    </table>
    </div>
}
