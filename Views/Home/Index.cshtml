@model portal_academico.Models.HomeIndexViewModel
@{
    ViewData["Title"] = "Portal Académico";
}

<div class="p-4 mb-4 bg-light rounded-3 border">
    <h1 class="display-5">Portal Académico</h1>
    <p class="lead mb-1">Gestión de cursos y matrículas — Universidad</p>
    <p class="text-muted">Explora la oferta de cursos activos e inscríbete. Usuario coordinador: <code>coordinador@uni.edu</code>.</p>
    <a class="btn btn-primary" asp-controller="Catalogo" asp-action="Index">Ver catálogo</a>
    @if (User.Identity?.IsAuthenticated == true)
    {
        <a class="btn btn-outline-primary" asp-controller="Matriculas" asp-action="MisMatriculas">Mis matrículas</a>
    }
    else
    {
        <a class="btn btn-outline-secondary" asp-area="Identity" asp-page="/Account/Login">Iniciar sesión para inscribirte</a>
    }
    @if (Model.EsCoordinador)
    {
        <a class="btn btn-warning" asp-controller="Coordinador" asp-action="Index">Panel Coordinador</a>
    }
</div>

@if (User.Identity?.IsAuthenticated == false)
{
    <div class="alert alert-info">Inicia sesión para inscribirte en un curso.</div>
}

<div class="row mb-4">
    <div class="col-md-4">
        <div class="card text-center">
            <div class="card-body">
                <h5 class="card-title">Cursos activos</h5>
                <p class="display-6">@Model.TotalCursos</p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card text-center">
            <div class="card-body">
                <h5 class="card-title">Cupo total ofertado</h5>
                <p class="display-6">@Model.TotalCupos</p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card text-center">
            <div class="card-body">
                <h5 class="card-title">Mi rol</h5>
                <p class="display-6 fs-4">
                    @if (Model.EsCoordinador)
                    {<span class="badge bg-warning text-dark">Coordinador</span>}
                    else if (User.Identity?.IsAuthenticated == true)
                    {<span class="badge bg-success">Estudiante</span>}
                    else
                    {<span class="badge bg-secondary">Invitado</span>}
                </p>
            </div>
        </div>
    </div>
</div>

<h2>Oferta destacada</h2>
@if (!Model.CursosRecientes.Any())
{
    <div class="alert alert-warning">No hay cursos activos por el momento.</div>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Código</th>
                <th>Nombre</th>
                <th>Créditos</th>
                <th>Horario</th>
                <th>Cupo</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var c in Model.CursosRecientes)
            {
                <tr>
                    <td>@c.Codigo</td>
                    <td>@c.Nombre</td>
                    <td>@c.Creditos</td>
                    <td>@c.HorarioInicio.ToString("HH:mm") - @c.HorarioFin.ToString("HH:mm")</td>
                    <td>@c.CupoMaximo</td>
                    <td><a asp-controller="Catalogo" asp-action="Details" asp-route-id="@c.Id">Ver</a></td>
                </tr>
            }
        </tbody>
    </table>
}
