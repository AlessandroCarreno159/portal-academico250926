@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div class="auth-wrap" style="max-width: 720px;">
    <div class="auth-card">
        <span class="eyebrow">Error</span>
        <h1>Algo salió mal.</h1>
        <p class="text-muted-claude">Ocurrió un error al procesar tu solicitud. Inténtalo de nuevo.</p>

        @if (Model.ShowRequestId)
        {
            <p>
                <strong>ID de solicitud:</strong> <code>@Model.RequestId</code>
            </p>
        }

        <h2 class="h5 mt-4">Modo de desarrollo</h2>
        <p>
            Cambiar al entorno <strong>Development</strong> mostrará información más detallada sobre el error.
        </p>
        <p>
            <strong>El entorno de desarrollo no debe estar activado en aplicaciones publicadas.</strong>
            Puede mostrar información confidencial de las excepciones a los usuarios finales.
        </p>
        <a class="btn btn-outline-clay mt-2" asp-controller="Home" asp-action="Index">← Volver al inicio</a>
    </div>
</div>
